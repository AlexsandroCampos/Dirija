@model InstructorProfilePageViewModel
@{
    ViewData["Title"] = "Perfil";
    var u = Model.User;
    var i = Model.Instructor;
    var (statusText, statusCss) = Ui.ApprovalStatus(i.Status);
}
<section class="card-dj p-3 mb-3 d-flex gap-3 align-items-center">
    <div class="avatar avatar-lg" style="background:@Ui.AvatarColor(i.Id)" aria-hidden="true">@i.Initials</div>
    <div class="min-w-0">
        <h1 class="h5 fw-bold mb-0" style="color:var(--dj-ink)">@u.Name</h1>
        <div class="small text-muted-dj">@u.Email · @u.Phone</div>
        <div class="mt-1"><span class="badge @statusCss">@statusText</span></div>
    </div>
</section>

<partial name="_StatusBanner" model="i" />

<h2 class="section-title">Como os alunos veem você</h2>
<div class="card-dj p-3 mb-3 small">
    <div class="fact mb-1"><i class="bi bi-cash-coin" aria-hidden="true"></i><div>@Ui.Money(i.PricePerLesson) por aula · Categoria @Ui.Categories(i.Categories)</div></div>
    <div class="fact mb-1"><i class="bi bi-car-front" aria-hidden="true"></i><div>@i.Vehicle@(i.HasDualControl ? " · duplo comando" : "")</div></div>
    <div class="fact mb-1"><i class="bi bi-pin-map" aria-hidden="true"></i><div>@i.MeetingPoint (@i.Neighborhood) · atende a até @i.ServiceRadiusKm.ToString("0") km</div></div>
    <div class="fact"><i class="bi bi-patch-check" aria-hidden="true"></i><div>Credencial nº @i.DetranCredential</div></div>
</div>

<h2 class="section-title">Conta</h2>
<div class="list-group mb-3">
    <a asp-action="Onboarding" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
        <span><i class="bi bi-briefcase lead-icon" aria-hidden="true"></i> Dados profissionais e ponto de encontro</span><i class="bi bi-chevron-right" aria-hidden="true"></i>
    </a>
    <a asp-action="Availability" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
        <span><i class="bi bi-calendar3-week lead-icon" aria-hidden="true"></i> Disponibilidade semanal</span><i class="bi bi-chevron-right" aria-hidden="true"></i>
    </a>
    <a asp-controller="Account" asp-action="EditData" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
        <span><i class="bi bi-pencil-square lead-icon" aria-hidden="true"></i> Nome e telefone</span><i class="bi bi-chevron-right" aria-hidden="true"></i>
    </a>
    <a asp-controller="Account" asp-action="ChangePassword" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
        <span><i class="bi bi-key lead-icon" aria-hidden="true"></i> Alterar senha</span><i class="bi bi-chevron-right" aria-hidden="true"></i>
    </a>
</div>

<form asp-controller="Account" asp-action="Logout" method="post">
    <button type="submit" class="btn btn-outline-danger w-100"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Sair</button>
</form>
