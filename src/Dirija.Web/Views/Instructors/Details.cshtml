@model InstructorDetailsViewModel
@{
    var i = Model.Instructor;
    ViewData["Title"] = i.Name;
    var firstDayWithSlots = Math.Max(0, Model.Days.ToList().FindIndex(d => d.Slots.Count > 0));
    string Stars(double r) { var f = (int)Math.Round(r); return new string('★', f) + new string('☆', 5 - f); }
}
@section Head {
    <partial name="_LeafletHead" />
}

<a asp-controller="Home" asp-action="Index" class="d-inline-flex align-items-center gap-1 mb-2 text-decoration-none">
    <i class="bi bi-arrow-left" aria-hidden="true"></i> Voltar para a busca
</a>

<section class="card-dj profile-hero mb-3">
    <div class="d-flex gap-3 align-items-center">
        <div class="avatar avatar-lg" style="background:@Ui.AvatarColor(i.Id)" aria-hidden="true">@i.Initials</div>
        <div class="min-w-0">
            <h1 class="h4 fw-bold mb-1" style="color:var(--dj-ink)">@i.Name</h1>
            <div class="small">
                <span class="stars" aria-hidden="true">@Stars(i.AverageRating)</span>
                <strong>@Ui.Rating(i.AverageRating)</strong>
                <span class="text-muted-dj">(@Ui.ReviewCount(i.ReviewCount)) · @Ui.LessonCount(i.LessonsGiven)</span>
            </div>
            @if (i.IsVerified)
            {
                <div class="verified mt-1"><i class="bi bi-patch-check-fill" aria-hidden="true"></i> Credencial Detran verificada (@i.DetranCredential)</div>
            }
        </div>
    </div>
    <p class="mt-3 mb-3">@i.Bio</p>

    <div class="row g-3">
        <div class="col-12 col-md-6 d-flex flex-column gap-2">
            <div class="fact"><i class="bi bi-cash-coin" aria-hidden="true"></i><div><strong>@Ui.Money(i.PricePerLesson)</strong> por aula de @i.LessonMinutes min</div></div>
            <div class="fact"><i class="bi bi-card-checklist" aria-hidden="true"></i><div>Categoria @Ui.Categories(i.Categories)</div></div>
            <div class="fact"><i class="bi bi-car-front" aria-hidden="true"></i><div>@i.Vehicle@(i.HasDualControl && !i.Vehicle.Contains("duplo comando") ? " · com segurança extra" : "")</div></div>
            <div class="fact"><i class="bi bi-pin-map" aria-hidden="true"></i><div><strong>Ponto de encontro:</strong> @i.MeetingPoint</div></div>
            <div class="fact"><i class="bi bi-bullseye" aria-hidden="true"></i><div>Atende em até @i.ServiceRadiusKm.ToString("0") km de @i.Neighborhood</div></div>
        </div>
        <div class="col-12 col-md-6">
            <div id="mini-map" role="img" aria-label="Mapa da área de atendimento em @i.Neighborhood, raio de @i.ServiceRadiusKm.ToString("0") quilômetros"
                 data-lat="@i.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                 data-lng="@i.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                 data-radius="@((i.ServiceRadiusKm * 1000).ToString(System.Globalization.CultureInfo.InvariantCulture))"></div>
        </div>
    </div>
</section>

<section class="card-dj p-3 mb-3" aria-labelledby="agenda-title">
    <h2 id="agenda-title" class="section-title">Escolha um horário</h2>
    <ul class="nav day-tabs" role="tablist">
        @for (var d = 0; d < Model.Days.Count; d++)
        {
            var day = Model.Days[d];
            <li class="nav-item" role="presentation">
                <button class="nav-link @(d == firstDayWithSlots ? "active" : "")" id="tab-@d" data-bs-toggle="tab" data-bs-target="#day-@d"
                        type="button" role="tab" aria-controls="day-@d" aria-selected="@(d == firstDayWithSlots ? "true" : "false")">
                    @Ui.DayLabel(day.Date, Model.Today)
                    <span class="visually-hidden">, @day.Slots.Count horários livres</span>
                </button>
            </li>
        }
    </ul>
    <div class="tab-content pt-2">
        @for (var d = 0; d < Model.Days.Count; d++)
        {
            var day = Model.Days[d];
            <div class="tab-pane fade @(d == firstDayWithSlots ? "show active" : "")" id="day-@d" role="tabpanel" aria-labelledby="tab-@d" tabindex="0">
                @if (day.Slots.Count == 0)
                {
                    <p class="text-muted-dj small mb-0 py-2">Sem horários livres neste dia.</p>
                }
                else
                {
                    <div class="slot-grid">
                        @foreach (var slot in day.Slots)
                        {
                            <form asp-controller="Bookings" asp-action="Reserve" method="post" class="m-0">
                                <input type="hidden" name="slotId" value="@slot.Id" />
                                <button type="submit" class="btn btn-outline-primary"
                                        aria-label="Reservar @Ui.DayLabel(day.Date, Model.Today) às @slot.Start.ToString("HH:mm")">
                                    @slot.Start.ToString("HH:mm")
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>
        }
    </div>
    <p class="small text-muted-dj mt-3 mb-0">
        <i class="bi bi-clock-history" aria-hidden="true"></i> Ao escolher, o horário fica reservado para você por 10 minutos enquanto finaliza o pagamento.
    </p>
</section>

<section class="card-dj p-3" aria-labelledby="reviews-title">
    <h2 id="reviews-title" class="section-title">Avaliações de alunos</h2>
    @if (Model.Reviews.Count == 0)
    {
        <p class="text-muted-dj mb-0">Este instrutor ainda não recebeu avaliações em texto.</p>
    }
    @foreach (var r in Model.Reviews)
    {
        <article class="review">
            <div class="d-flex justify-content-between">
                <strong>@r.StudentName</strong>
                <span class="small text-muted-dj">@r.CreatedAt.ToString("dd/MM/yyyy")</span>
            </div>
            <div class="stars small" role="img" aria-label="Nota @r.Rating de 5">@Stars(r.Rating)</div>
            @if (!string.IsNullOrWhiteSpace(r.Comment))
            {
                <p class="mb-0 mt-1">@r.Comment</p>
            }
        </article>
    }
</section>

@section Scripts {
    <script>
        (function () {
            const el = document.getElementById("mini-map");
            const ll = [parseFloat(el.dataset.lat), parseFloat(el.dataset.lng)];
            const map = L.map(el, { scrollWheelZoom: false, dragging: !L.Browser.mobile, zoomControl: false }).setView(ll, 12);
            L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                maxZoom: 19, attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
            }).addTo(map);
            const circle = L.circle(ll, { radius: parseFloat(el.dataset.radius), color: "#157a3b", weight: 2, fillColor: "#22c55e", fillOpacity: 0.18 }).addTo(map);
            L.circleMarker(ll, { radius: 6, color: "#0c3d1f", fillColor: "#0c3d1f", fillOpacity: 1 }).addTo(map);
            map.fitBounds(circle.getBounds());
        })();
    </script>
}
