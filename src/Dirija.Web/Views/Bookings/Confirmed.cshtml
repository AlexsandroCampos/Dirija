@model CheckoutViewModel
@{
    ViewData["Title"] = "Aula confirmada";
}
<div class="text-center my-3">
    <div class="d-inline-grid rounded-circle mb-2" style="width:72px;height:72px;place-items:center;background:#e6f4ea;color:#1a7f37;font-size:2.4rem">
        <i class="bi bi-check-lg" aria-hidden="true"></i>
    </div>
    <h1 class="h4 fw-bold" style="color:var(--dj-ink)">Aula confirmada!</h1>
    <p class="text-muted-dj">Pagamento aprovado via @(Model.Booking.PaymentLabel ?? "PIX"). Enviamos os detalhes para você.</p>
</div>

<div class="row g-3">
    <div class="col-12 col-md-6">
        <section class="card-dj p-3 h-100" aria-label="Resumo da aula">
            <partial name="_BookingSummary" model="Model" />
        </section>
    </div>
    <div class="col-12 col-md-6">
        <section class="card-dj p-3 h-100" aria-labelledby="next-steps">
            <h2 id="next-steps" class="section-title">Próximos passos</h2>
            <ol class="mb-0 ps-3 d-grid gap-2">
                <li>Leve sua <strong>LADV</strong> (Licença de Aprendizagem) e um documento com foto.</li>
                <li>Chegue ao ponto de encontro 5 minutos antes: <strong>@Model.Instructor.MeetingPoint</strong>.</li>
                <li>Você pode cancelar sem custo pela tela <em>Minhas aulas</em> até o horário da aula.</li>
                <li>Depois da aula, avalie o instrutor para ajudar outros alunos.</li>
            </ol>
        </section>
    </div>
</div>

<div class="d-grid d-sm-flex gap-2 mt-3">
    <a asp-action="Index" class="btn btn-primary btn-lg">Ver minhas aulas</a>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary btn-lg">Buscar mais instrutores</a>
</div>
